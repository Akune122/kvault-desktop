# ============================================================================
# KVAULT DESKTOP — CONFIGURATION (.env)
# ============================================================================
# Copiez ce fichier en ".env" à la racine du projet et remplissez vos infos.
# Le fichier ".env" est ignoré par Git (.gitignore) pour protéger vos accès !
# ============================================================================

# Mode de connexion kDrive : "api" (Recommandé : compatible offres gratuites & payantes)
# ou "webdav" (Uniquement offres kDrive Solo / Pro / kSuite payantes)
KDRIVE_CONNECTION_MODE=api

# Identifiant numérique de votre kDrive
# -> Connectez-vous sur https://ksuite.infomaniak.com/kdrive
# -> Regardez l'URL : https://ksuite.infomaniak.com/.../drive/123456/files
# -> Votre KDRIVE_ID est le numéro après "/drive/" (ex: 123456)
KDRIVE_ID=

# ----------------------------------------------------------------------------
# OPTION 1 : MODE API OFFICIELLE INFOMANIAK (Recommandé — KDRIVE_CONNECTION_MODE=api)
# ----------------------------------------------------------------------------
# Créez un Token API sur : https://manager.infomaniak.com/v3/ng/profile/user/token/list
# Cochez la permission / scope : "drive" (Gestion de kDrive)
KDRIVE_API_TOKEN=

# ----------------------------------------------------------------------------
# OPTION 2 : MODE WEBDAV (Optionnel — KDRIVE_CONNECTION_MODE=webdav)
# ----------------------------------------------------------------------------
# Votre adresse email de connexion Infomaniak
KDRIVE_EMAIL=
# Mot de passe d'application généré dans Sécurité -> Mots de passe d'application
KDRIVE_APP_PASSWORD=

# ----------------------------------------------------------------------------
# PHASE 2 (v0.2.0 - Préparation Bitwarden)
# ----------------------------------------------------------------------------
BITWARDEN_SERVER_URL=https://vault.bitwarden.eu
BITWARDEN_CLIENT_ID=
BITWARDEN_CLIENT_SECRET=
