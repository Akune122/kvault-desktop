# ============================================================================
# KVAULT DESKTOP — CONFIGURATION (.env)
# ============================================================================
# Copiez ce fichier en ".env" à la racine du projet et remplissez vos infos.
# Le fichier ".env" est ignoré par Git (.gitignore) pour protéger vos accès !
# Toutes ces options sont aussi modifiables directement dans l'application (⚙️ Paramètres).
# ============================================================================

# ----------------------------------------------------------------------------
# 🛡️ SÉCURITÉ DE L'APPLICATION (Écran de verrouillage au lancement)
# ----------------------------------------------------------------------------
# Code PIN ou mot de passe demandé à l'ouverture de KVault Desktop.
# Par défaut : 0000 (modifiable dans l'interface ⚙️ Paramètres, même sur le .exe)
APP_LOCK_CODE=0000

# ----------------------------------------------------------------------------
# ☁️ MODULE 1 : INFOMANIAK KDRIVE
# ----------------------------------------------------------------------------
# Mode de connexion kDrive : "api" (Recommandé : compatible offres gratuites & payantes)
# ou "webdav" (Uniquement offres kDrive Solo / Pro / kSuite payantes)
KDRIVE_CONNECTION_MODE=api

# Identifiant numérique de votre kDrive (chiffres après "/drive/" dans l'URL web kDrive)
KDRIVE_ID=

# Option 1 : Token API Officiel Infomaniak (Scope requis : "drive")
KDRIVE_API_TOKEN=

# Option 2 : WebDAV (Uniquement si KDRIVE_CONNECTION_MODE=webdav)
KDRIVE_EMAIL=
KDRIVE_APP_PASSWORD=

# ----------------------------------------------------------------------------
# 🔐 MODULE 2 : COFFRE-FORT BITWARDEN / VAULTWARDEN (v0.2.0)
# ----------------------------------------------------------------------------
# Serveur Bitwarden : https://vault.bitwarden.eu , https://vault.bitwarden.com ou URL Vaultwarden
BITWARDEN_SERVER_URL=https://vault.bitwarden.eu

# Email de votre compte Bitwarden (optionnel, pré-rempli dans l'interface)
BITWARDEN_EMAIL=

# Connexion recommandée par Clé API Bitwarden (Paramètres Web Bitwarden -> Sécurité -> Clés -> Voir la clé API)
# Permet de se connecter sans blocage Captcha et avec 2FA actif.
# Note : Votre Mot de passe maître n'est JAMAIS stocké ici (demandé uniquement au déverrouillage en mémoire).
BITWARDEN_CLIENT_ID=
BITWARDEN_CLIENT_SECRET=
